{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "outDir": "./dist", "rootDir": "./src",
    "strict": true, "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false, "skipLibCheck": true, "sourceMap": false, "incremental": false
  },
  "include": ["src/**/*.ts"], "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
