{
  "name": "@ayandeh/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "migrate:deploy": "prisma migrate deploy",
    "create-super-admin": "node dist/cli/create-super-admin.js",
    "test": "vitest run",
    "seed:dev": "node dist/cli/seed-dev.js",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run test"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/throttler": "6.3.0",
    "@prisma/client": "6.2.1",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "marked": "15.0.4",
    "prisma": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sanitize-html": "2.13.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@swc/core": "1.10.4",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/sanitize-html": "2.13.0",
    "@types/supertest": "6.0.2",
    "@types/web-push": "3.6.4",
    "supertest": "7.0.0",
    "typescript": "5.7.2",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
