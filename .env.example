# Copy to .env on the SERVER only. Never commit the real file.
POSTGRES_USER=root
POSTGRES_PASSWORD=f210c32a-7466-4344-8ada-83922310a48d
POSTGRES_DB=ayandeh
# GHCR image coordinates (lowercase owner/org) and tag to deploy (sha-<commit> or vX.Y.Z)
IMAGE_OWNER=your-github-user-or-org
IMAGE_TAG=latest
# Public port the web container is published on (put HTTPS reverse proxy in front)
WEB_PORT=8080
# Must be true behind HTTPS. Set false only for plain-http local testing.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# Only needed for first-run bootstrap (see README); remove afterwards
# SUPERADMIN_USERNAME=admin
# SUPERADMIN_PASSWORD=1234
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
MAX_UPLOAD_MB=50
# Optional antivirus (compose profile 'antivirus'); uploads are rejected if the scanner is configured but unreachable
# CLAMAV_HOST=clamav
# CLAMAV_FAIL_OPEN=false
